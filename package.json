{
  "name": "kaspa-covenant-game-kit",
  "version": "0.1.0",
  "description": "Reusable Kaspa TN10 SilverScript covenant escrow and game settlement kit.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./adapters/gomoku": "./src/adapters/gomoku.js"
  },
  "files": [
    "src",
    "contracts",
    "docs",
    "examples",
    "vendor",
    ".env.example",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w00c00/kaspa-covenant-game-kit.git"
  },
  "scripts": {
    "check": "find src examples test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test"
  },
  "keywords": [
    "kaspa",
    "tn10",
    "silverscript",
    "covenant",
    "game",
    "escrow"
  ],
  "dependencies": {
    "@kluster/kaspa-wasm": "2.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
