+
+fn write_settlement_journal(
+    path: &Path,
+    network: LabNetwork,
+    covenant_id: &str,
+    release_to: &str,
+    txid: &str,
+    released_sompi: u64,
+    status: &str,
+) -> Result<()> {
+    let parent = path.parent().filter(|value| !value.as_os_str().is_empty()).unwrap_or_else(|| Path::new("."));
+    std::fs::create_dir_all(parent).with_context(|| format!("cannot create journal directory {}", parent.display()))?;
+    let temporary = path.with_extension(format!("tmp-{}", std::process::id()));
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary)
+        .with_context(|| format!("cannot create settlement journal {}", temporary.display()))?;
+    writeln!(file, "version=1")?;
+    writeln!(file, "network={}", network.explorer_path())?;
+    writeln!(file, "covenant_id={covenant_id}")?;
+    writeln!(file, "release_to={release_to}")?;
+    writeln!(file, "txid={txid}")?;
+    writeln!(file, "released_sompi={released_sompi}")?;
+    writeln!(file, "status={status}")?;
+    file.sync_all()?;
+    drop(file);
+    std::fs::rename(&temporary, path)
+        .with_context(|| format!("cannot commit settlement journal {}", path.display()))?;
+    if let Ok(directory) = std::fs::File::open(parent) {
+        let _ = directory.sync_all();
     }
     Ok(())
 }
