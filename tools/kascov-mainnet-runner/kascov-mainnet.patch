+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LabNetwork {
+    Tn10,
+    Mainnet,
+}
+
+impl LabNetwork {
+    pub fn parse(value: &str) -> Result<Self> {
+        match value.trim().to_ascii_lowercase().as_str() {
+            "tn10" | "testnet-10" | "testnet10" => Ok(Self::Tn10),
+            "mainnet" | "kaspa" | "kaspa-mainnet" => Ok(Self::Mainnet),
+            other => bail!("unsupported network {other}; use tn10 or mainnet"),
+        }
+    }
+
+    fn network_id(self) -> NetworkId {
+        match self {
+            Self::Tn10 => NetworkId::with_suffix(NetworkType::Testnet, 10),
+            Self::Mainnet => NetworkId::new(NetworkType::Mainnet),
+        }
+    }
+
+    fn prefix(self) -> Prefix {
+        match self {
+            Self::Tn10 => Prefix::Testnet,
+            Self::Mainnet => Prefix::Mainnet,
+        }
+    }
+
+    fn symbol(self) -> &'static str {
+        match self {
+            Self::Tn10 => "TKAS",
+            Self::Mainnet => "KAS",
+        }
+    }
+
+    fn explorer_path(self) -> &'static str {
+        match self {
+            Self::Tn10 => "testnet-10",
+            Self::Mainnet => "mainnet",
+        }
+    }
+}
