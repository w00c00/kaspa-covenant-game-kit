# Default: TN10 testnet.
KASPA_COVENANT_NETWORK=tn10
# Required in production; comma-separate additional trusted browser origins.
PUBLIC_ORIGINS=https://game.example.com

# To enable mainnet explicitly:
# KASPA_COVENANT_NETWORK=mainnet
# KASPA_COVENANT_ALLOW_MAINNET=true
# KASPA_COVENANT_MAINNET_MAX_STAKE_KAS=1
# KASPA_COVENANT_MAINNET_PROGRAM_APPROVED=false
# KASPA_COVENANT_MAINNET_PROGRAM_FINGERPRINT=
# SILVERC_BIN=/absolute/path/to/silverc
# KASPA_COVENANT_MAINNET_SILVERC_SHA256=
# KASPA_COVENANT_MAINNET_SETTLEMENT_RUNNER_APPROVED=false
# KASPA_COVENANT_MAINNET_SETTLEMENT_RUNNER_SHA256=
# KASCOV_LAB_JOURNAL_DIR=/absolute/private/data/settlement-journal

# Optional endpoint overrides.
# KASPA_TN10_REST_API=https://api-tn10.kaspa.org
# KASPA_TN10_EXPLORER_API=https://api-tn10.kaspa.org
# KASPA_TN10_KASCOV_NETWORK=testnet-10
# KASPA_TN10_KASCOV_EXPLORER=https://kascov.io/share/testnet-10
# KASPA_TN10_KASCOV_LIVE_DATA=https://kascov.io/data/testnet-10-live.json
# KASPA_MAINNET_REST_API=https://api.kaspa.org
# KASPA_MAINNET_EXPLORER_API=https://api.kaspa.org
# KASPA_MAINNET_KASCOV_NETWORK=mainnet
# KASPA_MAINNET_KASCOV_EXPLORER=https://kascov.io/share/mainnet
# KASPA_MAINNET_KASCOV_LIVE_DATA=https://kascov.io/data/mainnet-live.json
