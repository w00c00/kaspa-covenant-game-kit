{
  "name": "kaspa-snooker-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A polished on-chain snooker game powered by Kaspa Covenant Game Kit.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 0.0.0.0\" \"node --watch server/index.mjs\"",
    "build": "vite build",
    "start": "node server/index.mjs",
    "check": "node --check server/index.mjs && node --check server/snooker-adapter.cjs && node --check src/main.js",
    "test": "node --test server/*.test.cjs test/*.test.mjs"
  },
  "dependencies": {
    "@kluster/kaspa-wasm": "2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "kaspa-covenant-game-kit": "file:../..",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
