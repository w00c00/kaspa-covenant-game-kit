[Unit]
Description=Kaspa Snooker TN10 Arena
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snooker
Group=snooker
WorkingDirectory=/opt/kaspa-snooker
Environment=NODE_ENV=production
EnvironmentFile=-/opt/kaspa-snooker/.env
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/kaspa-snooker/data

[Install]
WantedBy=multi-user.target
